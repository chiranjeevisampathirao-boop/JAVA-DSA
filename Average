Print the average of the integers in an integer array .
Input: {32,5,3,9,6}& output:5

   public static void main(String[] args) {
        int[] arr = {2, 5, 3, 9, 6};

        int sum = 0;
        for (int i: arr) {
            sum += i;
        }

        int average = sum / arr.length;

        System.out.println(average);
    }
}
